{
  "name": "ha-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-integrity.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deps": "node scripts/build-dependency-index.mjs",
    "render-check": "vite build -c .ssrcheck/vite.config.mjs -l error && esbuild src/lib/buttons.ts --format=esm --outfile=.ssrcheck/buttons.mjs --log-level=error && node .ssrcheck/run.mjs",
    "entities": "node scripts/check-entities.mjs",
    "capture:zones": "node scripts/capture-zones.mjs",
    "capture:scripts": "node scripts/capture-scripts.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "home-assistant-js-websocket": "^9.4.0"
  }
}
