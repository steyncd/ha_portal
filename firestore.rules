rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bootstrap owners: always allowed as owners, even before settings/access
    // exists, so the first sign-in works and can seed the list. Keep in sync
    // with BOOTSTRAP_OWNERS in src/lib/auth.svelte.ts.
    function bootstrap() {
      return request.auth != null
        && request.auth.token.email in [
          'christosteyn@cloudbadger.com',
          'steyncd@gmail.com'
        ];
    }
    function accessExists() {
      return exists(/databases/$(database)/documents/settings/access);
    }
    function accessData() {
      return get(/databases/$(database)/documents/settings/access).data;
    }
    function isOwner() {
      return request.auth != null && (
        bootstrap() ||
        (accessExists() && request.auth.token.email in accessData().owners)
      );
    }
    function isMember() {
      return isOwner() ||
        (request.auth != null && accessExists()
         && request.auth.token.email in accessData().members);
    }
    // Guests: signed in + listed in access.guests, but NOT a member. They get a
    // forced, restricted view (client-enforced by role) and read-only Firestore
    // limited to what the app needs to boot (access doc + HA connection).
    function isGuest() {
      return request.auth != null && accessExists()
        && !isMember()
        && request.auth.token.email in accessData().guests;
    }
    function isAllowed() { return isMember() || isGuest(); }

    // Access list: members + guests read (guests need it to learn their role +
    // allowed views); owners manage.
    match /settings/access {
      allow read: if isAllowed();
      allow write: if isOwner();
    }

    // HA connection token: guests need it to open the live WebSocket; members write.
    match /settings/haConnection {
      allow read: if isAllowed();
      allow write: if isMember();
    }

    // Per-user profile: any allowed user reads; only the doc's owner writes.
    match /profiles/{uid} {
      allow read: if isAllowed();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Access log: allowed users append their own events; owners read + prune.
    match /access_log/{id} {
      allow read: if isOwner();
      allow create: if isAllowed()
        && request.resource.data.email == request.auth.token.email.lower();
      allow update, delete: if isOwner();
    }

    // Explain-this-chart cache: written server-side by the explainChart
    // Function (Admin SDK bypasses rules). Members may read so a cached
    // explanation can be shown without another model call; nobody writes
    // from the client.
    match /chartExplain/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    // Proactive AI nudges: written server-side by the anomalyNudges Function
    // (Admin SDK bypasses rules). Members read them and may only flip them to
    // dismissed from the app — never forge one.
    match /nudges/{id} {
      allow read: if isMember();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['dismissed', 'dismissedAt']);
      allow create, delete: if isOwner();
    }

    // Usage log: every deliberate quick-action tap and view open, appended by
    // the user who performed it. Powers the "Suggested for now" frecency
    // ranking and the Usage analytics panel. Members read (to see household
    // usage); only owners prune.
    match /action_log/{id} {
      allow read: if isMember();
      allow create: if isAllowed()
        && request.resource.data.email == request.auth.token.email.lower();
      allow update, delete: if isOwner();
    }

    // ---- Watchlist app (separate access model from the portal) ----
    // Bootstrap admins can always manage it (seed + add others); after that the
    // admin/allowed lists in watchlist/access govern access. Fully private:
    // non-allowed signed-in users can't read anything here.
    function waAccessExists() {
      return exists(/databases/$(database)/documents/watchlist/access);
    }
    function waAccess() {
      return get(/databases/$(database)/documents/watchlist/access).data;
    }
    function waAdmin() {
      return bootstrap()
        || (request.auth != null && waAccessExists()
            && request.auth.token.email in waAccess().admins);
    }
    function waAllowed() {
      return waAdmin()
        || (request.auth != null && waAccessExists()
            && request.auth.token.email in waAccess().allowed);
    }
    // access doc: allowed users read (to learn their role); admins write.
    // watched doc: allowed users read + write (shared marks across accounts).
    match /watchlist/{doc} {
      allow read: if waAllowed();
      // Shared per-household lists (watched/shortlist/watch-again/reactions/votes/
      // watchedAt) are writable by any allowed user; other docs are admin-only.
      allow write: if (doc == 'watched' || doc == 'shortlist' || doc == 'watchAgain'
                       || doc == 'reactions' || doc == 'votes' || doc == 'watchedAt'
                       || doc == 'maybeLater'
                       || doc == 'musicStar' || doc == 'musicLiked' || doc == 'musicNi')
        ? waAllowed() : waAdmin();
    }
    match /watchlist_movies/{id} {
      allow read: if waAllowed();
      allow write: if waAdmin();
    }
    // Listening Room (Christian music) — same access model as the movie list.
    match /music_items/{id} {
      allow read: if waAllowed();
      allow write: if waAdmin();
    }

    // ---- Visitor passes ----------------------------------------------------
    // OWNER-ONLY to issue or revoke. The handover is explicit that owner is the
    // only role that issues passes, and without this block the catch-all below
    // would let any member issue themselves one — which is precisely the "a role
    // that only hides views is tidiness, not security" failure. Members may READ,
    // so the family can see who currently has access to the house.
    //
    // Scope enforcement lives here and in HA's own token permissions. The client
    // filters the vocabulary as a convenience; this is the gate.
    match /passes/{id} {
      allow read: if isMember();
      allow create, update, delete: if isOwner();
      // Audit trail is append-only from the Admin SDK; nothing writes it here.
      match /audit/{entry} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    // ---- Maintenance windows -----------------------------------------------
    // A window suppresses alarms, digest lines and staleness badges for its
    // target, so opening one is a security-adjacent act: owner-only. Members read,
    // because a suppression nobody can see is indistinguishable from a system
    // that stopped working.
    //
    // The "must have an end time" rule is enforced HERE as well as in the client,
    // since a client-only check is a suggestion.
    match /maintenance/{id} {
      allow read: if isMember();
      allow create: if isOwner()
        && request.resource.data.endsAt is int
        && request.resource.data.endsAt > request.time.toMillis()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0;
      allow update: if isOwner()
        && request.resource.data.endsAt is int
        && request.resource.data.endsAt > request.time.toMillis();
      allow delete: if isOwner();
    }

    // ---- Alarm objects -----------------------------------------------------
    // Raised and cleared server-side. A member may acknowledge or snooze — that
    // is the whole point of the ack loop — but may not forge, retitle or clear
    // one, because "I know" must never be able to masquerade as "it is fixed".
    match /alarms/{id} {
      allow read: if isMember();
      allow create: if isMember();
      // Two legitimate updates, and the invariant sits between them:
      //   (a) acknowledging or snoozing — only those three keys move;
      //   (b) RE-RAISING a condition that is still true, which refreshes the
      //       title or severity and must not be blocked, or the ack loop breaks
      //       the first time the page reloads with the doc already in Firestore.
      // In case (b) the ack fields must be UNCHANGED. That is what stops a
      // re-raise from quietly wiping "Christo said he knows about this".
      allow update: if isMember() && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ackBy', 'ackAt', 'snoozeUntil'])
        || (request.resource.data.ackBy == resource.data.ackBy
            && request.resource.data.ackAt == resource.data.ackAt)
      );
      allow delete: if isOwner();
      match /audit/{entry} {
        allow read: if isMember();
        allow create: if isMember();
        allow update, delete: if false;
      }
    }

    // ---- Generated config: cadence, appliance drift -------------------------
    // Written ONLY by the nightly Functions (Admin SDK bypasses rules). Client
    // writes are refused outright: a forged cadence blob would silently change
    // every freshness threshold in the app, which is the quietest possible way to
    // make the whole staleness system lie.
    match /config/{doc} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // Badge count + digest bookkeeping: server-owned, member-readable.
    match /badge/{doc} {
      allow read: if isMember();
      allow write: if false;
    }
    match /digestState/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /interruptLog/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Everything else (logged data, messages, etc.): household members only.
    // Guests are intentionally excluded here — they get no broad Firestore read.
    //
    // NOTE: this catch-all is why every block above matters. Anything not named
    // explicitly is member-read-write, so a new collection is permissive by
    // default rather than closed. Add the rule when you add the collection.
    match /{document=**} {
      allow read, write: if isMember();
    }
  }
}
